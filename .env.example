# Required for Gmail report integration
GMAIL_ACCOUNT=your.email@example.com

# Optional Ollama configuration
OLLAMA_MODEL=llama2:7b-chat-q2_K
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_NUM_GPU=24

# Optional exact LinkedIn profile URL
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/your-profile/

# Optional path overrides
# AUTOAPPLY_PROFILE_FILE=C:\path\to\candidate_profile.json
# AUTOAPPLY_ROOT=C:\path\to\autoapply
# AUTOAPPLY_OLLAMA_EXE=C:\path\to\ollama.exe
# AUTOAPPLY_REDIS_EXE=C:\path\to\redis-server.exe
